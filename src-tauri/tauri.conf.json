{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "miqat",
  "version": "1.4.0",
  "identifier": "com.mo.miqat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "مِيقَات",
        "width": 620,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "externalBin": [],
    "resources": [],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
